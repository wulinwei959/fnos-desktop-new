{
    "name": "fnos-desktop-new",
    "version": "0.1.0",
    "description": "FNOS 飞牛桌面客户端（通用 NAS 控制台 + 影视播放），合并自 fntv-electron / Fntv-Plus / fnos-desktop；GPL-3.0",
    "main": "dest/main/main.js",
    "license": "GPL-3.0",
    "scripts": {
        "build:proxy:win": "cd src/modules/proxy && go build -o ../../../third_party/proxy/proxy.exe",
        "setup:mpv": "node scripts/setup-mpv.mjs --auto",
        "start": "npm run clean && npm run build:proxy:win && tsc && electron .",
        "compile": "tsc",
        "test": "npm run compile && node --test tests/*.test.cjs",
        "watch": "tsc --watch",
        "clean": "rimraf dest",
        "build:win": "npm-run-all -s build:proxy:win compile && electron-builder --win"
    },
    "author": "wulinwei959",
    "devDependencies": {
        "@types/cacheable-request": "^6.0.3",
        "@types/debug": "^4.1.12",
        "@types/express": "^5.0.3",
        "@types/fs-extra": "^11.0.4",
        "@types/http-cache-semantics": "^4.0.4",
        "@types/keyv": "^3.1.4",
        "@types/ms": "^2.1.0",
        "@types/multistream": "^4.1.3",
        "@types/node": "^20.19.11",
        "@types/plist": "^3.0.5",
        "@types/responselike": "^1.0.3",
        "@types/verror": "^1.10.11",
        "@types/yauzl": "^2.10.3",
        "copyfiles": "^2.4.1",
        "electron": "44.4.5",
        "electron-builder": "^26.0.12",
        "npm-run-all": "^4.1.5",
        "rimraf": "^5.0.9",
        "sharp": "^0.34.3",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "axios": "^1.11.0",
        "express": "^5.1.0",
        "http-proxy-middleware": "^3.0.5",
        "http-range-fetcher": "^2.0.0",
        "multistream": "^4.1.0",
        "node-cache": "^5.1.2",
        "node-mpv-2": "^2.0.0-beta.3",
        "semver": "^7.7.2",
        "uuid": "^13.0.0"
    },
    "build": {
        "directories": {
            "output": "release"
        },
        "icon": "build/icon.ico",
        "productName": "FNOS 桌面",
        "artifactName": "FNOS-Desktop_${version}_win_${arch}.${ext}",
        "appId": "com.wulinwei959.fnos-desktop",
        "compression": "normal",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "extraFiles": [
                {
                    "from": "third_party/fntv-mpv",
                    "to": "third_party/fntv-mpv",
                    "filter": [
                        "**/*"
                    ]
                },
                {
                    "from": "third_party/proxy",
                    "to": "third_party/proxy",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "oneClick": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "dest",
            "build",
            "resource/login"
        ]
    }
}
